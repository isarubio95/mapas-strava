# Proyecto de Supabase. La clave publicable puede llegar al navegador:
# el acceso a los datos lo protege RLS.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

