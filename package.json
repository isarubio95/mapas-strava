{
  "name": "trazo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:local": "react-router dev --mode e2e",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > app/lib/supabase/database.types.ts",
    "mock:strava": "tsx tests/strava-mock/server.ts --port 4010"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@deck.gl/aggregation-layers": "~9.4.0",
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/maplibre": "~9.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@luma.gl/core": "~9.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-router/fs-routes": "^8.4.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vis.gl/react-maplibre": "^8.1.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "comlink": "^4.4.2",
    "date-fns": "^4.4.0",
    "flatbush": "^4.6.2",
    "isbot": "^5",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.54.0",
    "maplibre-gl": "^6.13.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.0.3"
  }
}
